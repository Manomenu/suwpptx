server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Liveness of the container itself, independent of the API.
    location = /healthz {
        access_log off;
        add_header content-type text/plain always;
        return 200 "ok\n";
    }

    # The browser only ever sees one origin, as behind the vite proxy in development. The upstream goes through a
    # variable so nginx looks the name up again (every 10 s): a recreated server container gets a new address.
    # With a variable and no URI in proxy_pass the request goes on unchanged, /api prefix included.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Uploads are raw request bodies of up to 2 GB (the server's Folder:UploadLimitMegabytes): streamed to the
        # server as they arrive instead of being written to a temporary file in the web container first.
        client_max_body_size 2g;
        proxy_request_buffering off;
    }

    # Server-Sent Events: a buffered or cached response would reach the browser only when the stream ends, and the
    # default read timeout would cut a quiet stream after a minute.
    location = /api/changes {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 2g;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        add_header cache-control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header cache-control "no-cache";
    }
}
