# Copy to .env (gitignored). Every line is optional: the defaults in compose.yaml work for `just up`.
# IMAGE_TAG=local
# WEB_PORT=8200
# The folder the app works on, mounted into the server container (default: ~/suwpptx). Created if missing.
# SUWPPTX_ROOT=/home/you/suwpptx
# The user the server container runs as, so files it writes into that folder are yours (run `id -u` and `id -g`).
# UID=1000
# GID=1000
# Rootless Podman only: run the server as root inside the container, which is your user on the host. Leave unset on Docker.
# SERVER_USER=0:0
# API_UPSTREAM=http://server:6310
