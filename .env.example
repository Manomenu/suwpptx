# Copy to .env (gitignored). Every line is optional: the defaults in compose.yaml work for `just up`.
# IMAGE_TAG=local
# WEB_PORT=8200
# POSTGRES_USER=suwpptx
# POSTGRES_PASSWORD=suwpptx
# POSTGRES_DB=suwpptx
# An external PostgreSQL: set this and start without the db profile (docker compose up -d).
# ConnectionStrings__Default=Host=db.example.internal;Port=5432;Database=suwpptx;Username=suwpptx;Password=change-me
# API_UPSTREAM=http://server:6310
