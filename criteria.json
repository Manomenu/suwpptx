{
  "specs": "docs/visual/spec",
  "prose": ["docs/**", "**/*.md"],
  "kinds": [
    { "kind": "server test (xunit)", "paths": ["Suwpptx.Server.Tests/*/**/*.cs"], "how": "[Trait(\"criterion\", \"<id>\")] on the test" },
    { "kind": "architecture test (xunit)", "paths": ["Suwpptx.Server.Tests/*.cs"], "how": "[Trait(\"criterion\", \"<id>\")] on the test" },
    { "kind": "e2e test (playwright)", "paths": ["Suwpptx.Web/src/**/*.e2e.ts"], "how": "the id in the title: test(\"<id>: …\")" },
    { "kind": "web test (vitest)", "paths": ["Suwpptx.Web/src/**/*.test.ts", "Suwpptx.Web/src/**/*.test.tsx"], "how": "the id in the title: it(\"<id>: …\")" },
    { "kind": "lint (eslint)", "paths": ["Suwpptx.Web/eslint.config.js"], "how": "// <id> on the line above the rule" },
    { "kind": "type check (tsc)", "paths": ["Suwpptx.Web/tsconfig*.json"], "how": "// <id> on the line above the option" },
    { "kind": "lint (.NET analyzer)", "paths": [".editorconfig"], "how": "# <id> on its own line above the rule" },
    { "kind": "banned API", "paths": ["BannedSymbols.txt"], "how": "the id in the message: P:…;<id> use …" },
    { "kind": "build rule", "paths": ["Directory.Build.props"], "how": "<!-- <id> --> above the property" }
  ]
}
