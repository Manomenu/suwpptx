<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Suwpptx.Server</RootNamespace>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <!-- Why: package.sh publishes single-file apps for these runtimes; declaring them (and the single-file analyzer,
         which brings ILLink.Tasks) here keeps one lock file for build and publish, as CI restores in locked mode -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="PDFtoImage" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Suwpptx.Server.Tests" />
  </ItemGroup>
</Project>
