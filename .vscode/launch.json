{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "server",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/Suwpptx.Server/Suwpptx.Server.csproj"
        },
        {
            "name": "attach to a running server",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "web (vite dev)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/Suwpptx.Web",
            "command": "pnpm dev"
        }
    ]
}
